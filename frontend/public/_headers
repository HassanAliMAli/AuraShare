# Long-cache fingerprinted assets (immutable — safe to cache for a year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML and root-level files — revalidate always
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/logo.svg
  Cache-Control: public, max-age=86400

# Root document — prevent stale HTML on deploys
/
  Cache-Control: public, max-age=0, must-revalidate

# Security headers applied to all static responses
#
# HSTS is also set by the zone. The edge value wins, and the live edge sends
# max-age=15552000 without preload, so this line mirrors it instead of
# claiming a policy the deployment does not apply. Preload needs a one-year
# max-age and an explicit submission; change both places before enabling it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://aurashare.hassanali.site; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' data:
