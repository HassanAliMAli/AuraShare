    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
